<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Portfolio Tracker</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" rel="stylesheet">
    <link href="https://cdn.datatables.net/responsive/2.5.0/css/responsive.bootstrap5.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="navbar app-topbar">
        <a class="app-brand" asp-area="" asp-controller="Home" asp-action="Index">
            <span class="app-brand-mark" aria-hidden="true"></span>
            <span class="app-brand-text">Portfolio</span>
        </a>
        @if (User.Identity?.IsAuthenticated ?? false)
        {
            var displayName = User.FindFirst("display_name")?.Value ?? User.Identity?.Name ?? "User";
            var initials = string.Join("", displayName
                .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                .Select(s => s.Length > 0 ? s[0].ToString().ToUpperInvariant() : "")
                .Take(2));
            if (string.IsNullOrWhiteSpace(initials))
            {
                initials = "U";
            }
            <nav class="app-nav" aria-label="Primary">
                <a class="@(Context.Request.Path == "/" || Context.Request.Path == "/Home" || Context.Request.Path == "/Home/Index" ? "active" : "")" asp-area="" asp-controller="Home" asp-action="Index">Dashboard</a>
                <a class="@(Context.Request.Path.StartsWithSegments("/Summary") ? "active" : "")" asp-area="" asp-controller="Summary" asp-action="Index">Summary</a>
                <a class="@(Context.Request.Path.StartsWithSegments("/RealisedPnL") ? "active" : "")" asp-area="" asp-controller="RealisedPnL" asp-action="Index">Realised P&amp;L</a>
                <a class="@(Context.Request.Path.StartsWithSegments("/InvestmentDiary") ? "active" : "")" asp-area="" asp-controller="InvestmentDiary" asp-action="Index">Investment Diary</a>
                <a class="@(Context.Request.Path.StartsWithSegments("/PortfolioDiary") ? "active" : "")" asp-area="" asp-controller="PortfolioDiary" asp-action="Index">Portfolio Diary</a>
                <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
            </nav>
            <div class="app-account">
                <span class="app-user" title="@displayName">
                    <span class="user-avatar">@initials</span>
                    <span class="user-name">@displayName</span>
                </span>
                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                    @Html.AntiForgeryToken()
                    <button class="btn btn-sm btn-outline-light" type="submit">Sign out</button>
                </form>
            </div>
        }
        else
        {
            <nav class="app-nav app-nav-end" aria-label="Primary">
                <a asp-controller="Account" asp-action="Login">Sign in</a>
            </nav>
        }
    </header>

    <div class="page-wrapper">
        <main class="pb-4">
            @RenderBody()
        </main>
    </div>

    <footer class="app-footer bg-dark text-light text-center py-3 border-top border-secondary mt-5">
        <div class="container">
            &copy; 2026 - Portfolio Tracker | <a asp-area="" asp-controller="Home" asp-action="Privacy" class="text-light">Privacy</a>
        </div>
    </footer>

    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/responsive.bootstrap5.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
